# SmartDocs runs fully with zero configuration (see the "local" AI provider).
# The variables below are optional — set them to unlock live/paid integrations.

# --- AI (optional) ---------------------------------------------------------
# Get a key at https://openrouter.ai. Without this, SmartDocs uses its
# built-in local documentation generator (see src/lib/ai/mock-provider.ts) —
# fully functional, deterministic, and free.
OPENROUTER_API_KEY=
# Any model slug supported by OpenRouter. Defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=

# --- GitHub (optional) ------------------------------------------------------
# A personal access token raises the GitHub API rate limit from 60 to 5000
# requests/hour and lets you analyze private repositories you have access to.
GITHUB_TOKEN=

# --- Planned integrations (not yet wired up — see README roadmap) ---------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
